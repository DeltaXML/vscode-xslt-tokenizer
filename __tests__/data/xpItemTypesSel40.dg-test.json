{
  "suite": "xpItemTypesSel40",
  "source": "xpItemTypesSel40.xsl",
  "description": "XPath Lexer: expected tokens for each XSLT select attribute",
  "attributeName": "select",
  "xsltVersion": "4.0",
  "metadata": {
    "moduleName": "xpLexerTestGen.js",
    "version": "1.7.2"
  },
  "tests": [
    {
      "label": "choiceSel1",
      "xpath": "'2020-01-01' instance of (xs:date | xs:string)",
      "problems": []
    },
    {
      "label": "choiceSel2",
      "xpath": "'2020-01-01' cast as (xs:date | xs:time)",
      "problems": []
    },
    {
      "label": "choiceSel3",
      "xpath": "'2020-01-01' castable as (xs:date | xs:time)?",
      "problems": []
    },
    {
      "label": "choiceSel4",
      "xpath": "'a' instance of (ct:complex | xs:string)+",
      "problems": []
    },
    {
      "label": "choiceSel5",
      "xpath": "'a' treat as (map(*) | xs:string)",
      "problems": []
    },
    {
      "label": "enumSel1",
      "xpath": "'red' instance of enum('red', 'green')",
      "problems": []
    },
    {
      "label": "enumSel2",
      "xpath": "'red' cast as enum('red', 'green')",
      "problems": []
    },
    {
      "label": "recordSel1",
      "xpath": "map { 'r': 1.0, 'i': 2.0 } instance of record(r as xs:double, i as xs:double)",
      "problems": []
    },
    {
      "label": "recordSel2",
      "xpath": "map { 'a': 1 } treat as record('a', b? as xs:string)",
      "problems": []
    },
    {
      "label": "fnParamSel1",
      "xpath": "function($a as (xs:string | xs:integer)) as record(n as xs:integer) { map { 'n': $a } }",
      "problems": []
    },
    {
      "label": "fnTypeSel1",
      "xpath": "abs#1 instance of fn(xs:numeric?) as xs:numeric?",
      "problems": []
    },
    {
      "label": "namedSel1",
      "xpath": "map { 'r': 1.0, 'i': 2.0 } instance of ct:complex",
      "problems": []
    },
    {
      "label": "plainSel1",
      "xpath": "5 instance of xs:integer+",
      "problems": []
    },
    {
      "label": "pathUnion1",
      "xpath": "(a | b)",
      "problems": []
    },
    {
      "label": "pathUnion2",
      "xpath": "(a | b)[1]",
      "problems": []
    },
    {
      "label": "pathUnion3",
      "xpath": "a/(b | c)",
      "problems": []
    },
    {
      "label": "oldUnionSel1",
      "xpath": "'a' instance of union(xs:date, xs:string)",
      "problems": [
        [
          "XPath: 'union(...)' is not supported - use a choice item type instead, e.g. (xs:date | xs:time)",
          "union"
        ]
      ]
    },
    {
      "label": "recordSel3",
      "xpath": "map {} instance of record()",
      "problems": []
    },
    {
      "label": "recordSel4",
      "xpath": "map { 'a b': 1 } instance of record('a b', 'c'?)",
      "problems": []
    },
    {
      "label": "choiceSelErr1",
      "xpath": "'a' cast as (xs:date | xs:time)*",
      "problems": [
        [
          "XPath: Invalid type: '*'",
          "*"
        ]
      ]
    },
    {
      "label": "oldTupleSel1",
      "xpath": "map {} instance of tuple(a)",
      "problems": [
        [
          "XPath: 'tuple(...)' is not supported - use 'record(...)' instead",
          "tuple"
        ]
      ]
    }
  ]
