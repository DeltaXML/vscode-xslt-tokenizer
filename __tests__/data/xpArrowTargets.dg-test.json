          "substring"
        ]
      ]
    },
    {
      "label": "arrowTargetError2",
      "xpath": "2 => 'abc'",
      "problems": [
        [
          "XPath: Expression context - unexpected token here: 'abc' ",
          "'abc'"
        ]
      ]
    }
  ]
