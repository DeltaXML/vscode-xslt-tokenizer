{
  "suite": "xpBracedIf40",
  "source": "xpBracedIf40.xsl",
  "description": "XPath Lexer: expected tokens for each XSLT select attribute",
  "attributeName": "select",
  "xsltVersion": "4.0",
  "metadata": {
    "moduleName": "xpLexerTestGen.js",
    "version": "1.7.2"
  },
  "tests": [
    {
      "label": "bracedIf1",
      "xpath": "if (true()) { 1 }",
      "problems": []
    },
    {
      "label": "bracedIf2",
      "xpath": "if (true()) {}",
      "problems": []
    },
    {
      "label": "bracedIf3",
      "xpath": "if (true()) { 1, 2 }",
      "problems": []
    },
    {
      "label": "bracedIf4",
      "xpath": "(if (true()) { 1 }, 2)",
      "problems": []
    },
    {
      "label": "bracedIf5",
      "xpath": "if (true()) { if (false()) { 1 } }",
      "problems": []
    },
    {
      "label": "bracedIf6",
      "xpath": "if (true()) { if (false()) then 1 else 2 }",
      "problems": []
    },
    {
      "label": "bracedIf7",
      "xpath": "if (true()) then if (false()) { 1 } else 2",
      "problems": []
    },
    {
      "label": "bracedIf8",
      "xpath": "let $a := 1 return if ($a eq 1) { 'one' }",
      "problems": []
    },
    {
      "label": "bracedIf9",
      "xpath": "for $a in (1, 2) return if ($a gt 1) { $a }",
      "problems": []
    },
    {
      "label": "bracedIf10",
      "xpath": "if (true()) { map { 'a': 1 } }",
      "problems": []
    },
    {
      "label": "bracedIf11",
      "xpath": "if (true()) { (: comment :) 1 }",
      "problems": []
    },
    {
      "label": "bracedIf12",
      "xpath": "if (true()) (: comment :) { 1 }",
      "problems": []
    },
    {
      "label": "unbracedIf1",
      "xpath": "if (true()) then 1 else 2",
      "problems": []
    },
    {
      "label": "bracedIfError1",
      "xpath": "if (true()) { 1 } else { 2 }",
      "problems": [
        [
          "'else' has no matching 'then'",
          "else"
        ]
      ]
    },
    {
      "label": "bracedIfError2",
      "xpath": "if (true()) 1",
      "problems": [
        [
          "XPath: 'then' expected after 'if ($condition)' but found: '1'",
          "1"
        ],
        [
          "'if' has no matching 'then'",
          "if"
        ]
      ]
    },
    {
      "label": "bracedIfError3",
      "xpath": "if (true()) then 1",
      "problems": [
        [
          "'then' has no matching 'else'",
          "then"
        ]
      ]
    }
  ]
}