{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es6",
		"outDir": "out",
		"sourceMap": true,
		"rootDir": ".",
		"strict": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@modelcontextprotocol/server": ["node_modules/@modelcontextprotocol/server/dist/index.d.mts"],
			"@modelcontextprotocol/server/ext/skills/node": ["node_modules/@modelcontextprotocol/server/dist/ext/skills/node.d.mts"],
			"@modelcontextprotocol/node": ["node_modules/@modelcontextprotocol/node/dist/index.d.mts"]
