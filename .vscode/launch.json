// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				// other extensions are disabled, except the XSLT Dark Themes extension, which is loaded as a second development extension
				// - update its version here after the extension updates
				"--disable-extensions",
				"--extensionDevelopmentPath=${workspaceFolder:vscode-xslt-tokenizer}",
				"--extensionDevelopmentPath=${userHome}/.vscode/extensions/deltaxml.xslt-dark-themes-1.3.0"
			],
			"outFiles": [
				"${workspaceFolder:vscode-xslt-tokenizer}/out/**/*.js"
			],
			"preLaunchTask": "npm: watch"
		},
		{
			// scripted demos for recording videos (scripts/demo): the extension, the demo runner and the XSLT Dark Themes,
			// in the demo's own folder - then run 'Demo: Play Video 1...' from the Command Palette
			"name": "Demo: Record Videos",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--disable-extensions",
				"--extensionDevelopmentPath=${workspaceFolder:vscode-xslt-tokenizer}",
				"--extensionDevelopmentPath=${workspaceFolder:vscode-xslt-tokenizer}/scripts/demo",
				"--extensionDevelopmentPath=${userHome}/.vscode/extensions/deltaxml.xslt-dark-themes-1.4.1",
				"${workspaceFolder:vscode-xslt-tokenizer}/scripts/demo/workspace"
			],
			"outFiles": [
				"${workspaceFolder:vscode-xslt-tokenizer}/out/**/*.js"
			],
			"preLaunchTask": "npm: watch"
		},
		{
			"name": "Run Extension Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder:vscode-xslt-tokenizer}",
				"--extensionTestsPath=${workspaceFolder:vscode-xslt-tokenizer}/out/test/vscode-ext"
			],
			"outFiles": [
				"${workspaceFolder:vscode-xslt-tokenizer}/out/test/**/*.js"
			],
			"preLaunchTask": "npm: watch"
		},
		{
            "type": "node",
            "request": "launch",
            "name": "Run XPath Diagnostics",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder:vscode-xslt-tokenizer}/out/xpLexerRun.js",
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": [
                "${workspaceFolder:vscode-xslt-tokenizer}/out/test/**/*.js"
            ]
		},
		{
            "type": "node",
            "request": "launch",
            "name": "Run XSL Diagnostics",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder:vscode-xslt-tokenizer}/out/xslLexerRun.js",
            "preLaunchTask": "tsc: build - tsconfig.json",
            "outFiles": [
                "${workspaceFolder:vscode-xslt-tokenizer}/out/test/**/*.js"
            ]
        }
	]
}
