// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": "build",
			"label": "npm: watch",
			"detail": "tsc -watch -p ./"
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": "$eslint-stylish",
			"label": "npm: lint",
			"detail": "eslint -c .eslintrc.js --ext .ts src"
		},
		{
			"type": "xslt-js",
			"label": "xslt: as-attributes-to-json",
			"xsltFile": "${workspaceFolder}/__tests__/scripts/xslAsAttributesToJson.xsl",
			"xmlSource": "${workspaceFolder}/__tests__/data/xsl-test-files/xpInAsAttribute.xsl",
			"resultPath": "${workspaceFolder}/__tests__/data/as-attributes-to-json-out.json",
			"group": {
				"kind": "test",
			},
			"problemMatcher": [
				"$saxon-xslt-js"
			]
		},
		{
            // CHAIN (1/2)
			// 1. prompts for input path
			// 2. uses hard-coded temp file as output
			"type": "xslt-js",
			"label": "gen: json from xsl - PICK - CHAIN (1/2)",
			"xsltFile": "${workspaceFolder}/__tests__/scripts/xslAsAttributesToJson.xsl",
			"xmlSource": "${input:sourceOfAsAttribute}",
			"resultPath": "${workspaceFolder}/temp/json-from-xml-out.json",
			"group": {
				"kind": "hidden",
			},
			"problemMatcher": [
				"$saxon-xslt-js"
			]
		},
		{
			// CHAIN (2/2)
			// 1. uses hard-coded temp file as input
			// 2. prompts for output path
			"label": "gen: expected test json from xsl - PICK in / out",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/out/__tests__/utils/xpLexerTestGen.js",
				"--file",
				"${workspaceFolder}/temp/json-from-xml-out.json",
				"--out",
				"${input:outExpectedJSONofAsAttribute}"
			],
			"dependsOn": [
				"gen: json from xsl - PICK - CHAIN (1/2)",
				"tsc: build - tsconfig.json"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test",
			"problemMatcher": []
		},
	],
	"inputs": [
		/*
		1. the specialist 'pickFile' command equivalents for the inputs defined here are:
			"xsltFile": "${command:xslt-xpath.pickXsltFile}",              // can select from current file - if xslt - or recently used xslt files
			"xmlSource": "${command:xslt-xpath.pickXmlSourceFile}",        // can select from current file or recently used stage1 source files
			"xmlSource": "${command:xslt-xpath.pickStage2XmlSourceFile}",  // can select from recently used stage2 source files or stage1 result files
			"resultPath": "${command:xslt-xpath.pickResultFile}",          // can save to recently used stage1 result files
			"resultPath": "${command:xslt-xpath.pickStage2ResultFile}",    // can save to recently used stage2 result files

		2. these inputs invoke the 'pickFile' command with args for custom behaviour:
		*/
		{
			/* --- Usage: ---
			"source": "${input:sourceOfAsAttribute}",
			*/
			"id": "sourceOfAsAttribute",
			"type": "command",
			"command": "xslt-xpath.pickFile",
			"args": {
				"label": "(1/4) select source XSLT for test",
				"extensions": [
					"xsl"
				]
			}
		},
		{
			/* --- Usage: ---
			"source": "${input:asAttributeRawJSON}",
			*/
			"id": "asAttributeRawJSON",
			"type": "command",
			"command": "xslt-xpath.pickFile",
			"args": {
				"label": "(3/4) select raw json input file",
				"prevStageLabel": "(2/4) select raw json output file",
				"prevStageGroup": "recent raw json output"
			}
		},
		{
			/* --- Usage: ---
			"out": "${input:outRawJSONofAsAttribute}",
			*/
			"id": "outRawJSONofAsAttribute",
			"type": "command",
			"command": "xslt-xpath.pickFile",
			"args": {
				"label": "(2/4) select raw json output file",
				"isResult": true
			}
		},
		{
			/* --- Usage: ---
			"out": "${input:outExpectedJSONofAsAttribute}",
			*/
			"id": "outExpectedJSONofAsAttribute",
			"type": "command",
			"command": "xslt-xpath.pickFile",
			"args": {
				"label": "(4/4) select raw json output file",
				"isResult": true
			}
		}
	]
}