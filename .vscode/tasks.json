// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": "build",
			"label": "npm: watch",
			"detail": "tsc -watch -p ./"
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": "$eslint-stylish",
			"label": "npm: lint",
			"detail": "eslint -c .eslintrc.js --ext .ts src"
		},
		{
			"type": "xslt-js",
			"label": "gen: json from xsl - PICK - CHAIN (1/2)",
			"xsltFile": "${workspaceFolder}/__tests__/scripts/xslXPathAttributesToJson.xsl",
			"initialTemplate": "initial",
			"xmlSource": "",
			"parameters": [
				{
					"name": "testSourceURL",
					"value": "${input:sourceOfXPathAttribute}"
				}
			],
			"resultPath": "${workspaceFolder}/temp/json-from-xml-out.json",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": false
			},
			"group": {
				"kind": "hidden"
			},
			"problemMatcher": [
				"$saxon-xslt-js"
			]
		},
		{
			"label": "gen: expected test json from xsl - PICK input",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/out/__tests__/utils/xpLexerTestGen.js",
				"--file",
				"${workspaceFolder}/temp/json-from-xml-out.json"
			],
			"dependsOn": [
				"gen: json from xsl - PICK - CHAIN (1/2)",
				"tsc: build - tsconfig.json"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"type": "xslt",
			"label": "schema-to-records with xsl:initial-template",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/sample/json-schema-records/schema-to-records.xsl",
			"xmlSource": "",
			"initialTemplate": "",
			"messageEscaping": "adaptive",
			"allowSyntaxExtensions40": "auto",
			"group": {
				"kind": "build"
			},
			"parameters": [
				{
					"name": "?schema-uri",
					"value": "'order.schema.json'"
				}
			]
		},
		{
			"type": "xslt",
			"label": "order-report with xsl:initial-template",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/sample/json-schema-records/order-report.xsl",
			"xmlSource": "",
			"initialTemplate": "",
			"messageEscaping": "adaptive",
			"allowSyntaxExtensions40": "auto",
			// "resultPath": "${workspaceFolder}/sample/json-schema-records/order-report-out.txt",
			"group": {
				"kind": "build"
			},
			"parameters": [
				{
					"name": "?order-uri",
					"value": "'order.json'"
				}
			]
		},
	],
	"inputs": [
		/*
			the 'pickFile' command enhances 'QuickPick' by allowing selectin from a 'recent files' list:
		*/
		{
			/* --- Usage: ---
			"source": "${input:sourceOfXPathAttribute}",
			*/
			"id": "sourceOfXPathAttribute",
			"type": "command",
			"command": "xslt-xpath.pickFile",
			"args": {
				"label": "select source XSLT for test",
				"extensions": [
					"xsl"
				]
			}
		},
	]
}