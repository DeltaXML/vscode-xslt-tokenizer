// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": "build",
			"label": "npm: watch",
			"detail": "tsc -watch -p ./"
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": "$eslint-stylish",
			"label": "npm: lint",
			"detail": "eslint -c .eslintrc.js --ext .ts src"
		},
		{
			// CHAIN (1/2)
			// 1. prompts for input path
			// 2. uses hard-coded temp file as output
			"type": "xslt-js",
			"label": "gen: json from xsl - PICK - CHAIN (1/2)",
			"xsltFile": "${workspaceFolder}/__tests__/scripts/xslXPathAttributesToJson.xsl",
			"initialTemplate": "initial",
			"parameters": [
				{
					"name": "testSourceURL",
					"value": "${input:sourceOfXPathAttribute}"
				}
			],
			"resultPath": "${workspaceFolder}/temp/json-from-xml-out.json",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"clear": false
			},
			"group": {
				"kind": "hidden",
			},
			"problemMatcher": [
				"$saxon-xslt-js"
			]
		},
		{
			// CHAIN (2/2)
			// invokes: xpLexerTestGen.js"
			// 1. uses hard-coded temp out file from CHAIN as input
			// 2. derives output path from input
			"label": "gen: expected test json from xsl - PICK input",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/out/__tests__/utils/xpLexerTestGen.js",
				"--file",
				"${workspaceFolder}/temp/json-from-xml-out.json",
			],
			"dependsOn": [
				"gen: json from xsl - PICK - CHAIN (1/2)",
				"tsc: build - tsconfig.json"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test",
			"problemMatcher": []
		},
	],
	"inputs": [
		/*
			the 'pickFile' command enhances 'QuickPick' by allowing selectin from a 'recent files' list:
		*/
		{
			/* --- Usage: ---
			"source": "${input:sourceOfXPathAttribute}",
			*/
			"id": "sourceOfXPathAttribute",
			"type": "command",
			"command": "xslt-xpath.pickFile",
			"args": {
				"label": "select source XSLT for test",
				"extensions": [
					"xsl"
				]
			}
		},
	]
}