// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": "build",
			"label": "npm: watch",
			"detail": "tsc -watch -p ./"
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": "$eslint-stylish",
			"label": "npm: lint",
			"detail": "eslint -c .eslintrc.js --ext .ts src"
		},
		{
			"type": "xslt-js",
			"label": "xslt: as-attributes-to-json",
			"xsltFile": "${workspaceFolder}/__tests__/scripts/xslAsAttributesToJson.xsl",
			"xmlSource": "${workspaceFolder}/__tests__/data/xsl-test-files/xpInAsAttribute.xsl",
			"resultPath": "${workspaceFolder}/__tests__/data/as-attributes-to-json-out.json",
			"group": {
				"kind": "test",
			},
			"problemMatcher": [
				"$saxon-xslt-js"
			]
		},
		{
			"label": "run: xpLexerTestGen.js",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/out/__tests__/utils/xpLexerTestGen.js",
				"--file",
				"${workspaceFolder}/__tests__/data/as-attributes-to-json-out.json"
			],
			"dependsOn": ["tsc: build - tsconfig.json"],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test",
			"problemMatcher": []
		},
	]
}